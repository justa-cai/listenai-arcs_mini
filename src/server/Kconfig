
config SERVER_VOICE_LSCHAT
    bool "Enable LSCHAT Voice Server"
    default n

if SERVER_VOICE_LSCHAT

config APP_WAKEUP_ENABLE
    bool "Enable wake word (wakeup engine)"
    default y
    help
      Master switch for wake word functionality. When disabled, platform
      init skips loading wakeup algo resources and never calls
      app_wakeup_init(): no mic capture / wakeup engine / AEC reference
      playback occupation. Related entry points (standby, sensitivity,
      wake word OTA stop) degrade to no-ops.

config APP_VOICE_OUTPUT_ENABLE
    bool "Enable voice output (prompt tones + TTS)"
    default y
    help
      Master switch for speech output. When disabled, voice_player_tone_submit
      and voice_player_tts_submit_url return immediately: no prompt tones
      (network success / netcfg guide / wakeup / OTA ...) and no LLM TTS
      playback. Music player is not affected. Useful when the product path
      owns audio0 (e.g. NES game) and any interleaved prompt would fight
      over the audio stream (distortion).

config MCP_TOOL_EMOJI_ENABLE
    bool "Enable emoji tool"
    default n

config MCP_TOOL_CAMERA_ENABLE
    bool "Enable camera tool"
    default n

config LSCHAT_WAKEUP_CLOUD_NOISE_GATE_THRESHOLD
    int "Wakeup cloud audio noise gate threshold"
    default 128
    range 0 32767
    help
      Samples whose absolute amplitude is below this threshold are muted
      before wakeup output audio is sent to cloud ASR.

endif

config AUDIO_DEFAULT_MIC_GAIN_A_DB
    int "Default analog microphone gain (dB)"
    default 0
    range -12 36

config AUDIO_DEFAULT_MIC_GAIN_D_DB
    int "Default digital microphone gain (dB)"
    default 0
    range -83 42

config AUDIO_DEFAULT_REF_GAIN_A_DB
    int "Default analog reference gain (dB)"
    default 0
    range -12 36

config AUDIO_DEFAULT_REF_GAIN_D_DB
    int "Default digital reference gain (dB)"
    default 0
    range -83 42

config AUDIO_DEFAULT_SPK_GAIN_A_DB
    int "Default analog speaker gain (dB)"
    default -6
    range -24 6

config AUDIO_DEFAULT_SPK_GAIN_D_DB
    int "Default digital speaker gain (dB)"
    default 0
    range -113 30

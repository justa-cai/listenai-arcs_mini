config FLEXIBLE_BUTTON
    bool "Flexible Button"
    default n

config BATTERY_COLLECTION
    bool "Battery Collection"
    default n

config LOW_WIFI_CLI
    bool "Low Wifi Cli"
    default n

config LSPLATFORM_DEFAULT_PRODUCT_ID
    string "LSPlatform default product id"
    default "cf75e7a9-66b6-41e3-918a-141800aebb5b"

config LSPLATFORM_DEFAULT_SECRET_ID
    string "LSPlatform default secret id"
    default "e354f1f0-34e5-488f-8ef2-f6db2a44c815"

config DEFAULT_MIC_GAIN
    int "Default mic gain"
    range 0 100
    default 80

config DEFAULT_AEC_GAIN
    int "Default aec gain"
    range 0 100
    default 0

config DEFAULT_VOLUME
    int "Default volume"
    range 0 100
    default 70

choice CLOUD_PROVIDER
    prompt "Cloud Provider Selection"
    default MY_CLOUD

config LISTEN_CLOUD
    bool "ListenAI Cloud (AIUI)"
    help
      Use ListenAI AIUI cloud service.

config MY_CLOUD
    bool "Self-hosted Cloud Server"
    help
      Use self-hosted cloud server with separate ASR/LLM/TTS services.

endchoice

config MY_CLOUD_HOST
    string "Self-hosted Cloud Server Host"
    default "192.168.1.169"
    depends on MY_CLOUD
    help
      The host address of the self-hosted cloud server.

rsource "$LISTENAI_MODULES"
rsource "modules/Kconfig"

/* Makefile */
MODULES = segger_rtt
CFLAGS = -I $(TOPDIR)/modules/segger_rtt/include 


/* test case */
#include "SEGGER_RTT.h"

void test_segger_rtt(void)
{
    unsigned int cnt = 0;

    printf("[%s:%d] SEGGER_RTT addr=0x%x\n", __func__, __LINE__, &_SEGGER_RTT);

    while(1)
    {
        cnt++;
        SEGGER_RTT_printf(0, "[%s:%d] test %d\n", __func__, __LINE__, cnt);
        printf("[%s:%d] test %d\n", __func__, __LINE__, cnt);
        DELAY_MS(1000);
    }
}



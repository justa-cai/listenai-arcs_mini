void modem_adc_dac_clk_init()
{
    //BLE 1M
    BT_MODEM_P->REG_TX_CFG5.bit.TX_BLE_1M_CLK_SRC   =  1;   // 0: xtal  24M    1: only modem tx from double en 48M  // only modem RX from pll 96M   
    BT_MODEM_P->REG_TX_CFG5.bit.TX_BLE_1M_CLK_DAC   =  2;   // 1: 24m=24m    2: 48m  // only modem clk source selected value, from arcs b should choose 2:48M
    BT_MODEM_P->REG_BT_CFG10.bit.RX_BLE_1M_CLK_SRC  =  1;
    BT_MODEM_P->REG_BT_CFG10.bit.RX_BLE_1M_CLK_ADC  =  1;
    //BLE 2M
    BT_MODEM_P->REG_TX_CFG5.bit.TX_BLE_2M_CLK_SRC   =  1;  // 0 from 24M XO,  1 from pll 48M in fpga, from pll in chip 96M
    BT_MODEM_P->REG_TX_CFG5.bit.TX_BLE_2M_CLK_DAC   =  2;  // 1:24m=24m    2: 48m   // only modem clk source selected value, from arcs b should choose 2:48M.   both 24m or 48m can work, 24M performance bad. so only vega chip used this config, vegap will used double clk
    BT_MODEM_P->REG_BT_CFG10.bit.RX_BLE_2M_CLK_SRC  =  1;   // 0 from 24M XO, 1 from pll 48M in fpga, from pll in chip 96M
    BT_MODEM_P->REG_BT_CFG10.bit.RX_BLE_2M_CLK_ADC  =  2;   // 0: when tx, double en=0, output clk = 24M    1: only modem tx from double en 48M, the RFP_SX_DOUBLER_EN should ==1

    BT_MODEM_P->REG_BT_CFG10.bit.RX_RSSI_BT_CLK_ADC  =  0x2;
    
    //bt br
    BT_MODEM_P->REG_TX_CFG5.bit.TX_BT_CLK_SRC       =  1; 
    BT_MODEM_P->REG_TX_CFG5.bit.TX_BT_CLK_DAC       =  2;
    BT_MODEM_P->REG_BT_CFG10.bit.RX_BT_CLK_SRC      =  1;
    BT_MODEM_P->REG_BT_CFG10.bit.RX_BT_CLK_ADC      =  1;
    //bt edr 

}


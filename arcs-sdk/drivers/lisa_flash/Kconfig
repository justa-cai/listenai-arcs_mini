menuconfig LISA_FLASH
	bool "Enable LISA Flash Driver"
	depends on LISA_DEVICE
	select LISA_FLASH_ARCS if SOC_ARCS
	select LISA_FLASH_ARCS if BOARD_ARCS_EVB
	select LISA_FLASH_ARCS if BOARD_ARCS_MINI
	select LISA_FLASH_VENUSA if SOC_VENUSA

	help
		Enable Flash device driver support for read/write/erase operations.

config LISA_FLASH_ARCS_HALT_BY_REMOTE_CORE
	bool "Allow this core to be halted during remote Flash operations"
	select ARCS_HAL_IPC
	select ARCS_HAL_IPC_HALT_BY_PEER_CORE
	help
			Allow this core to be halted by a remote core during LISA Flash
			operations.

if LISA_FLASH

config LISA_FLASH_HALT_REMOTE_CORE
	bool "Enable Flash remote-core halt protection"
	depends on SOC_VENUSA
	imply IPC_CIDU if SOC_VENUSA
	imply IC_MESSAGE_AUTO_INIT if SOC_VENUSA
	help
		Enable platform-specific protection for Flash operations that must
		stop or wait the remote core. On VenusA this weakly enables the CIDU
		ic_message backend and its SYS_INIT auto-init.

config LISA_FLASH_HOOK_WAITER_ONLY
	bool "Register Flash hook waiter without initializing Flash HAL"
	depends on LISA_FLASH_HALT_REMOTE_CORE
	depends on SOC_VENUSA
	help
		Register only the Flash hook ic-message receiver on a peer core that
		waits for remote Flash operations. The core will not initialize the
		Flash HAL, avoiding QSPI/Flash controller changes while the peer core
		owns Flash access.

config LISA_FLASH_INIT_PRIORITY
	int "LISA Flash init priority"
	default 15
	help
		LISA Flash driver device initialization priority. This initialization
		priority is used unless the driver implementation has its own
		initialization priority

rsource "Kconfig.arcs"
rsource "Kconfig.venusa"

endif # LISA_FLASH

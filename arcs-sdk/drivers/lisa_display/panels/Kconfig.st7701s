menu "ST7701S Display Panel"

if LISA_DISPLAY_PANEL_ST7701S

config PANEL_ST7701S_WIDTH
    int "screen width"
    default 480
    help
    The pixel length in the x-axis direction of the display screen, the maximum value is 480.

config PANEL_ST7701S_HEIGHT
    int "screen height"
    default 480
    help
    The pixel length in the y-axis direction of the display screen, the maximum value is 480.

config PANEL_ST7701S_X_OFFSET
    int "display screen x offset"
    default 0
    help
    The pixel offset in the x-axis direction of the display screen.

config PANEL_ST7701S_Y_OFFSET
    int "screen y offset"
    default 0
    help
    The pixel offset in the y-axis direction of the display screen.

config ROTATE_BUF_MAX_HEIGHT
    int "roate buffer buffer max height"
    default PANEL_ST7701S_WIDTH

endif

endmenu
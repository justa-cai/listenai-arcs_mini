osource "$ARCS_BASE/Kconfig"

menu "UAC sample configuration"

config UAC_MIC_SAMPLE_RATE
	int "UAC microphone sample rate"
	default 16000
	range 8000 48000

config UAC_MIC_CHANNELS
	int "UAC microphone channel count"
	default 2
	range 1 2

config UAC_MIC_SAMPLE_BITS
	int "UAC microphone sample bits"
	default 16
	range 16 32
	help
	  Supported values are 16, 24 and 32.

config UAC_SPK_SAMPLE_RATE
	int "UAC speaker sample rate"
	default 16000
	range 8000 48000

config UAC_SPK_CHANNELS
	int "UAC speaker channel count"
	default 1
	range 1 2

config UAC_SPK_SAMPLE_BITS
	int "UAC speaker sample bits"
	default 16
	range 16 32
	help
	  Supported values are 16, 24 and 32.

config UAC_MIC_PERIOD_MS
	int "Microphone USB write period in ms"
	default 1
	range 1 20

config UAC_MIC_RING_MS
	int "LISA audio microphone ring buffer time in ms"
	default 256
	range 16 2000

config UAC_SPK_READ_MS
	int "Speaker USB read period in ms"
	default 1
	range 1 20

config UAC_SPK_RING_MS
	int "USB speaker ring buffer time in ms"
	default 256
	range 16 2000

config UAC_TASK_STACK
	int "UAC task stack size"
	default 2048
	range 1024 8192

config UAC_ENABLE_BOARD_PA
	bool "Enable board speaker PA control"
	default y if BOARD_VENUSA_RD_EVB
	select LISA_AUDIO_PLAY_PA_ENABLE
	help
	  Enable board-level speaker power amplifier control for boards that
	  require it. venusa_rd_evb routes PA_EN to GPIOA0.

config LISA_AUDIO_PLAY_PA_PAD
	default 0 if UAC_ENABLE_BOARD_PA

config LISA_AUDIO_PLAY_PA_PIN
	default 0 if UAC_ENABLE_BOARD_PA

config LISA_AUDIO_PLAY_PA_PULSE_COUNT
	default 0 if UAC_ENABLE_BOARD_PA

config UAC_PLAY_BUFFER_COUNT
	int "LISA audio playback buffer count"
	default 12
	range 2 32

config UAC_PLAY_BUFFER_MS
	int "LISA audio playback buffer duration in ms"
	default 16
	range 1 100

config UAC_RECORD_ANALOG_GAIN
	int "LISA audio record analog gain"
	default 16

config UAC_RECORD_DIGITAL_GAIN
	int "LISA audio record digital gain"
	default 8

config UAC_PLAY_ANALOG_GAIN
	int "LISA audio playback analog gain"
	default 0

config UAC_PLAY_DIGITAL_GAIN
	int "LISA audio playback digital gain"
	default -12

config UAC_PLAY_VOLUME_DIVISOR
	int "UAC host volume attenuation divisor"
	default 4
	range 1 16

config UAC_PLAY_MUTE_DB
	int "UAC host volume mute threshold in dB"
	default -96
	range -100 -1

config UAC_RECORD_DIFFERENTIAL_INPUT
	bool "Use differential microphone input"
	default y

config UAC_RECORD_HPF
	bool "Enable record high-pass filter"
	default y

endmenu

osource "$ARCS_BASE/Kconfig"

config VADDR_REMAP_SAMPLE_BOOT_VARIANT_NAME
	string "vaddr remap sample boot variant name"
	default "AP"

config VADDR_REMAP_SAMPLE_FW_FLASH_OFFSET
	hex "vaddr remap sample firmware flash offset"
	default 0x20000

config VADDR_REMAP_SAMPLE_BOOT_FW_IN_CP
	bool "boot remapped firmware on CP core"

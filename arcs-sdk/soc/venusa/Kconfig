config SOC_VENUSA
	bool

if SOC_VENUSA

config HARTID
	int "Hart ID (0=AP, 1=CP)"
	range 0 1
	help
		Hart ID (0=AP, 1=CP)。直接嵌入 image header reserved[0],
		boot 在 CONFIG_BOOT_APP_CORE_AUTO 场景下据此选择目标核。
		加 prompt 让 prj.conf 能覆盖 SoC defconfig 给的默认值。

config VENUSA_AP_CORE
	bool
	default y if HARTID = 0
	help
		当前镜像运行在 VenusA AP 核（Hart 0）。内存默认布局会据此
		选择 AP 侧 SRAM、Flash 和 PSRAM 窗口。

config VENUSA_CP_CORE
	bool
	default y if HARTID = 1
	help
		当前镜像运行在 VenusA CP 核（Hart 1）。内存默认布局会据此
		选择 CP 侧 SRAM、Flash 和 PSRAM 窗口。

config SOC_HAS_NPU
	bool "SoC has NPU"
	help
		SoC 集成 NPU（神经网络处理单元）。
		由具体型号的 defconfig 自动设置，无需手动开启。

config DCACHE_ENABLE
	bool "Enable DCACHE"
	default y

config ICACHE_ENABLE
	bool "Enable ICACHE"
	default y

config PSRAM_INIT
	bool "PSRAM init"
	default y

config CLOCK_INIT
	bool "CLOCK init"
	default y

rsource "../common/Kconfig.mem.venusa"

endif # SOC_VENUSA

rsource "csk70xx/Kconfig"

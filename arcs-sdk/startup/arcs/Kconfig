
config MAIN_TASK_STACK_SIZE
    int "main task stack size"
    default 2048

config MAIN_TASK_PRIORITY
    int "main task priority"
    default 1

config DCACHE_ENABLE
    bool "Enable DCACHE"
    default y

config ICACHE_ENABLE
    bool "Enable ICACHE"
    default y

config LINK_CPP_RUNTIME_SECTIONS
    bool "link cpp runtime sections"
    default y
    help
        Link the C++ runtime sections

config CPP_EXCEPTIONS
    bool "Enable C++ exceptions"
    default y

config EXCEPTION_REBOOT_IMMEDIATELY
    bool "reboot immediately in exception handler"
    default n

config BOOT_WITH_WATCHDOG
    bool "boot with watchdog"
    default n
    help
        Enable the watchdog in boot

config WATCHDOG_ENABLE
    bool "watchdog enable"
    default y if BOOT_WITH_WATCHDOG
    help
        Enable the watchdog

config SYS_INIT
    bool "Enable system initialization framework"
    default y
    help
        Enable the SYS_INIT framework for multi-level system initialization.

        This framework provides 5 initialization levels that match ARCS boot flow:

        - PRE_SYSTEM_INIT:   BEFORE scatload (in platform_pre_startup)
                             ⚠️ WARNING: .data NOT copied, .bss NOT zeroed!
                             DO NOT use global variables!
        - PRE_DEVICES_INIT:  Before lisa_device_init()
        - PRE_KERNEL:        Before vTaskStartScheduler()
        - POST_KERNEL:       After vTaskStartScheduler()
        - PRE_APPLICATION:   Before main()

        Use SYS_INIT macro to register initialization functions at different levels.

        If unsure, say Y.

config SYS_INIT_DEBUG
    bool "Enable system initialization debug output"
    depends on SYS_INIT
    default n
    help
        Enable detailed debug logging for system initialization.

rsource "Kconfig.mem"
rsource "Kconfig.syslog"
rsource "Kconfig.debug"

#pragma once

#define PROJECT_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define PROJECT_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define PROJECT_VERSION_BUILD @PROJECT_VERSION_BUILD@
#define PROJECT_VERSION_COMMIT "@PROJECT_VERSION_COMMIT@"
#define PROJECT_VERSION_STR "@PROJECT_VERSION_STR@"

/* 单调整数版本号约定：MAJOR*1000000 + MINOR*1000 + BUILD
 * 每段预留 3 位，2.3.0 -> 2003000；upper bound 每段 999。OTA 用它判新旧。 */
#define PROJECT_VERSION_NUMBER \
    ((PROJECT_VERSION_MAJOR) * 1000000U + (PROJECT_VERSION_MINOR) * 1000U + (PROJECT_VERSION_BUILD))

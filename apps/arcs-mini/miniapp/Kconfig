menuconfig MINIAPP
    bool "Lua miniapps"
    default y
    help
      Run cloud-delivered Lua source in PSRAM. Source is transient; bounded app data can be saved in KV.

if MINIAPP

config MINIAPP_ADB_DEBUG
    bool "Debug local Lua scripts with adb push/pull"
    depends on ADB && CHERRYUSB_APP_CLASS && !ADB_SYNC
    default y
    help
      Register a small sync service for /miniapp/<id>.lua only. Receive
      source in PSRAM and start it without a filesystem or cloud download.
      Keep the active source for adb pull /miniapp/miniapp.lua. The source
      snapshot uses at most MINIAPP_SOURCE_MAX_BYTES plus a small header;
      an in-progress pull retains its snapshot across replacement or exit.
      Full ADB sync must stay disabled because both use the sync service.

config MINIAPP_SOURCE_MAX_BYTES
    int "Maximum Lua source bytes"
    range 1024 262144
    default 65536
    help
      Upper bound on one app's Lua source. Raising it also needs a matching
      MINIAPP_CHUNK_DEADLINE_MS: parsing is charged to the chunk budget, and
      the device parses about 130 bytes/ms, so 128 KiB already costs ~1 s
      before a single statement runs. Application-level opt-in only; the
      default keeps a startup stall under the original 1 s window.

config MINIAPP_HEAP_MAX_BYTES
    int "Maximum heap bytes per Lua VM"
    range 65536 524288
    default 393216
    help
      Replacing an active app temporarily needs two VMs for rollback.

config MINIAPP_SCREEN
    bool "Expose screen drawing"
    depends on APPLICATION_UI
    default y

config MINIAPP_SCREEN_WIDTH
    int "Miniapp screen width"
    range 1 2048
    default 240

config MINIAPP_SCREEN_HEIGHT
    int "Miniapp screen height"
    range 1 2048
    default 240

config MINIAPP_BUTTON
    bool "Expose the function button"
    default y

config MINIAPP_LED
    bool "Expose the status LED"
    default y

config MINIAPP_BUZZER
    bool "Expose speaker-generated tones"
    default y

endif

config MINIAPP_BUILTIN_APP
    bool "Autostart a Lua app from the luaapp flash partition"
    default n
    help
      Boot the firmware with one Lua app preloaded in flash. The app lives
      in a ROMFS image flashed at 0x580000 (partition "luaapp", between
      respak and app). A delayed task mounts it ~15 s after boot, installs
      /radio.lua under id "local:radio" and starts it. adb push to the
      same id still replaces it at runtime; the builtin copy returns on
      the next reboot. Skipped while a voice session is active.

config MINIAPP_BUILTIN_DELAY_MS
    int "Builtin app autostart delay"
    depends on MINIAPP_BUILTIN_APP
    range 3000 120000
    default 15000
    help
      Boot grace period before the builtin app takes the screen. Wait for
      network attach and the first UI paint, and keep voice interaction
      responsive during startup.

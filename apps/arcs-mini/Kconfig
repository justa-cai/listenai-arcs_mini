osource "$ARCS_BASE/Kconfig"

menu "Voice Application"

rsource "../../modules/Kconfig"
rsource "../../src/Kconfig"
orsource "../../apps-ui/Kconfig"

rsource "miniapp/Kconfig"

config APP_CAMERA_SERVICE
    bool "Start camera service at boot"
    default y
    help
      Camera service allocates two DVP frame buffers (~1.2MB PSRAM) at
      boot. Disable on memory-constrained builds (e.g. on-device LLM)
      to reclaim the runtime heap; UI camera flows then fail gracefully.

config LLM_TERMINAL_UI
    bool "LLM terminal as the only desktop UI"
    default n
    help
      Replace the standard app UI (home/standby/QR/emoji pages and their
      models) with a fullscreen LVGL terminal chatting with the AP-side
      LLM. Input comes from the network keyboard (UDP, tools/llmkb).
      Single-click button navigation to HOME is disabled accordingly.

config LLMTERM_TTS
    bool "Speak LLM answers via cloud TTS"
    default y
    depends on LLM_TERMINAL_UI
    help
      Subscribe to the streaming LLM answer in the terminal and speak
      each finished sentence through the cloud TTS pipeline
      (voice_cloud_tts_synth + voice_player_tts). Requires WiFi and the
      LSC cloud session; silently skipped when offline. Runtime toggle:
      "llmterm tts on|off".

config LLMTERM_ASR
    bool "Push-to-talk cloud ASR input for the terminal"
    default y
    depends on LLM_TERMINAL_UI && LS_CHAT
    help
      Hold the power/function key (PB4) to record, recognize via the
      AIUI cloud IAT session (NLU/TTS replies suppressed) and auto
      submit the text as a question to the LLM. Requires WiFi and the
      LSC cloud session; shows a hint and records nothing while
      offline. Runtime toggle: "llmterm asr on|off".

config CP_FIRMWARE_COMPAT
    bool "Embed CP PSRAM range"
    default y
    help
      Store the CP PSRAM base and size selected by prj.conf immediately after the
      standard ARCS image header so AP can reject an incompatible CP image.

config CP_FIRMWARE_COMPAT_OFFSET
    hex "CP PSRAM range image offset"
    default 0x180
    depends on CP_FIRMWARE_COMPAT
    help
      Offset from the CP image base. Keep this synchronized with AP.

endmenu
